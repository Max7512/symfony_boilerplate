{% extends 'base.html.twig' %}
{% trans_default_domain "dashboard" %}
{% block title %}
	{{ parent() }}
	|
	{{ "titre"|trans }}
{% endblock %}

{% block body %}
	<div class="conteneur colonne-centre dashboard">
        <h1>{{ "titre"|trans }}</h1>
        <div class="dashboard-grid">
            {{ component("DashboardVentes") }}
            {{ component("DashboardStock") }}
        </div>
        <h2>{{ "commandes"|trans }}</h2>
		{{ component("Commande", { dashboard: true }) }}
	</div>
{% endblock %}
